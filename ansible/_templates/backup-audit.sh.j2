#!/bin/bash

# --- CONFIGURATION ---
ZFS_SNAP_PATH="{{ script_vars.zfs_backup_path }}/.zfs/snapshot/auto-daily-$(date +%Y-%m-%d)"
UNRAID_PATH="{{ script_vars.unraid_array_path }}/$(date +%Y-%m-%d)"
HOSTNAME=$(hostname)
BACKUP_DATE=$(basename "$UNRAID_PATH")

# Format as YYYY-MM-DD for readability
if [[ "$BACKUP_DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    BACKUP_DATE_FORMATTED=$(date -d "$BACKUP_DATE" "+%d %B %Y" 2>/dev/null || echo "$BACKUP_DATE")
else
    BACKUP_DATE_FORMATTED="$BACKUP_DATE"
fi

# Hardcode DEBUG_MODE/SEND_TELEGRAM since User Scripts does not support UI
# arguments. Token/chat ID come from vault.yml (rendered at deploy time) --
# never hardcode these here, this file is git-tracked.
DEBUG_MODE=false
SEND_TELEGRAM=true
TELEGRAM_TOKEN="{{ home_notifier_telegram_token }}"
CHAT_ID="{{ home_notifier_telegram_chat_id }}"

# Apps whose backups are intentionally frozen (stack torn down but you plan to
# rebuild it, so the last backup must be kept rather than left to rotate out)
# get excluded from the staleness check ONLY -- every other check (checksum,
# size, existence, hollow-folder) still runs against them, so you'd still get
# alerted if the backup you're relying on to restore later got corrupted or
# deleted. Match against the app's top-level dir name under containers-backup/
# (same name as in application_services.yml). See notes/containers-backup.md
# for the full design rationale.
EXCLUDE_STALE=("guacamole")

