// Wall tablet (iPad Air 1) battery control, logic in automation/js/tabletBattery.js.
// Docs: notes/openhab/tablet-battery/README.md

Group gTabletBattery "Tablet battery control"

// Semantic model: two equipment in the Living Room (location group LivingRoom is managed in the UI).
// The night mode switch of the dashboard page (tablet.items) is a point of DashboardIPad too.
Group DashboardIPad      "Dashboard iPad"              <screen>      (LivingRoom) ["Display"]
Group DashboardIPadPlug  "Dashboard iPad charger plug" <poweroutlet> (LivingRoom) ["PowerOutlet"]

// --- the plug (things/tabletPlug.things) ---
Switch TabletPlug_State       "Plug"                          <poweroutlet> (gTabletBattery, persist_on_change, DashboardIPadPlug) ["Switch","Power"] { channel="mqtt:topic:tabletPlug:state" }
Number:Power TabletPlug_Power       "Power [%.0f W]"           <energy>      (gTabletBattery, persist_on_change, persist_every_minute, DashboardIPadPlug) ["Measurement","Power"] { channel="mqtt:topic:tabletPlug:power", unit="W" }
Number:ElectricCurrent TabletPlug_Current     "Current [%.2f A]"         <energy>      (gTabletBattery, DashboardIPadPlug) ["Measurement","Current"] { channel="mqtt:topic:tabletPlug:current", unit="A" }
Number:ElectricPotential TabletPlug_Voltage     "Voltage [%.0f V]"         <energy>      (gTabletBattery, DashboardIPadPlug) ["Measurement","Voltage"] { channel="mqtt:topic:tabletPlug:voltage", unit="V" }
Number:Energy TabletPlug_Energy      "Energy [%.2f kWh]"        <energy>      (gTabletBattery, DashboardIPadPlug) ["Measurement","Energy"] { channel="mqtt:topic:tabletPlug:energy", unit="kWh" }
Number TabletPlug_LinkQuality "Zigbee link quality [%d]"        <network>     (gTabletBattery, DashboardIPadPlug) ["Measurement","SignalStrength"] { channel="mqtt:topic:tabletPlug:linkquality" }
String TabletPlug_Online      "Zigbee availability [%s]"        <network>     (gTabletBattery, DashboardIPadPlug) ["Status","QualityOfService"] { channel="mqtt:topic:tabletPlug:availability" }

// --- read from the iPad (ioreg over ssh, every minute) ---
Number TabletBattery_Level           "Battery [%d %%]"                     <battery>     (gTabletBattery, restore_on_startup, persist_on_change, DashboardIPad) ["Measurement","StateOfCharge"]
Switch TabletBattery_Charging        "Charging"                            <energy>      (gTabletBattery, persist_on_change, DashboardIPad) ["Status","Power"]
Switch TabletBattery_Connected       "Charger connected"                    <poweroutlet> (gTabletBattery, persist_on_change, DashboardIPad) ["Status","Power"]
Switch TabletBattery_Reachable       "Battery readable (SSH)"                    <network>     (gTabletBattery, restore_on_startup, persist_on_change, DashboardIPad) ["Status","QualityOfService"]
DateTime TabletBattery_LastRead        "Battery read at [%1$tH:%1$tM]"          <time>        (gTabletBattery, restore_on_startup, DashboardIPad) ["Status","Timestamp"]
DateTime TabletBattery_UnreadableSince "Battery unreadable since [%1$td.%1$tm %1$tH:%1$tM]" <time> (gTabletBattery, restore_on_startup, DashboardIPad) ["Status","Timestamp"]

// --- control (defaults set by the startup rule when NULL) ---
Switch TabletBattery_Enabled         "Charge control"                   <switch>      (gTabletBattery, restore_on_startup, DashboardIPad) ["Control","Enabled"]
Switch TabletBattery_Notify          "Telegram on every plug switch"          <switch>      (gTabletBattery, restore_on_startup, DashboardIPad) ["Control","Enabled"]
Number TabletBattery_Low             "Charge from [%d %%]"                     <battery>     (gTabletBattery, restore_on_startup, DashboardIPad) ["Setpoint","StateOfCharge"]
Number TabletBattery_High            "Charge up to [%d %%]"                    <battery>     (gTabletBattery, restore_on_startup, DashboardIPad) ["Setpoint","StateOfCharge"]
Switch TabletBattery_Desired         "Plug wanted by charge control"                              <switch>      (gTabletBattery, restore_on_startup, persist_on_change, DashboardIPad) ["Status","Power"]
String TabletBattery_Reason          "Charging plan [%s]"                       <text>        (gTabletBattery, restore_on_startup, DashboardIPad) ["Status","Info"]
String TabletBattery_Alert           "Alerts [%s]"                        <error>       (gTabletBattery, restore_on_startup, DashboardIPad) ["Alarm"]
