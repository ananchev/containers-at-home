// Shared "Home" calendar (Nextcloud user `home`), filled by automation/js/homeCalendar.js.
// HomeCal_Events: JSON array, next 60 days, sorted by start:
//   {uid, rid?, t: title, s/e: 'YYYY-MM-DD' (all-day, e exclusive) or epoch ms, ad?: true, c?: [categories], loc?}
// Semantic model: an equipment without a location (shows under Equipment > Web Service)
Group    HomeCalendar    "Home calendar"                             <calendar>  ["WebService"]
String   HomeCal_Events  "Home calendar events"                      <calendar>  (HomeCalendar) ["Status","Info"]
String   HomeCal_Status  "Home calendar [%s]"                        <calendar>  (HomeCalendar) ["Status","Info"]
DateTime HomeCal_Updated "Home calendar updated [%1$td.%1$tm %1$tH:%1$tM]" <calendar> (HomeCalendar) ["Status","Timestamp"]
Switch   HomeCal_Refresh "Refresh home calendar"                     <calendar>  (HomeCalendar) ["Control"] { autoupdate="false" }
