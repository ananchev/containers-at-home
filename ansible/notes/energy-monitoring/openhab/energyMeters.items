// persistence groups used across the configuration
Group persist_on_change
Group persist_every_minute
Group persist_every_30min
Group persist_every_hour

// Energy monitoring (notes/energy-monitoring/README.md). The influxdb metadata maps meter -> circuit.
Group gEnergyRaw    // raw lifetime counters straight from the meters (not persisted)
Group gEnergyTotal  // validated lifetime counters (energy.rules), kWh
Group:Number:SUM gEnergyPower "House power (metered) [%d W]" <energy> ["Measurement","Power"]  // active power, W; group state = sum
Group gEnergyCost   // lifetime cost counters (energy.rules), EUR

Number   ElectricityTariff        "Electricity price [%.5f €/kWh]"                        <price> { channel="mqtt:topic:energyTariff:electricity" }
DateTime ElectricityTariffUpdated "Price fetched [%1$td-%1$tm-%1$tY %1$tH:%1$tM]"          <time>  { channel="mqtt:topic:energyTariff:updated" }

// meter 10: Hob
Number EnergyMeter10_Raw   "Hob counter (raw) [%.2f kWh]" <energy> (gEnergyRaw)   { channel="modbus:data:energyMeterLine10:10secPoller:reg0:number" }
Number EnergyMeter10_Total "Hob total [%.2f kWh]"         <energy> (gEnergyTotal, Line10) ["Measurement","Energy"] { influxdb="energy_total_kwh" [meter="10", circuit="kitchen_hob"] }
Number EnergyMeter10_Power "Hob power [%d W]"             <energy> (gEnergyPower, Line10) ["Measurement","Power"] { channel="modbus:data:energyMeterLine10:10secPoller:reg14:number", influxdb="energy_power_w" [meter="10", circuit="kitchen_hob"] }
Number EnergyMeter10_Cost  "Hob cost total [%.2f €]"      <price>  (gEnergyCost, Line10)  ["Measurement"] { influxdb="energy_cost_total_eur" [meter="10", circuit="kitchen_hob"] }
Number l10Voltage        "Voltage [%.1f V]"                    <voltage>        (Line10) ["Measurement","Voltage"] { channel="modbus:data:energyMeterLine10:10secPoller:reg12:number" }
Number l10Current        "Current [%.2f A]"                    <current>        (Line10) ["Measurement","Current"] { channel="modbus:data:energyMeterLine10:10secPoller:reg13:number" }
Number l10ReactivePower  "Reactive Power [%.3f kVar]"          <reactive_power> (Line10) ["Measurement","Power"] { channel="modbus:data:energyMeterLine10:10secPoller:reg15:number" }
Number l10PowerFactor    "Power Factor [%.3f]"                 <power_factor>   (Line10) ["Measurement"] { channel="modbus:data:energyMeterLine10:10secPoller:reg16:number" }
Number l10Frequency      "Frequency [%.2f Hz]"                 <sine>           (Line10) ["Measurement","Frequency"] { channel="modbus:data:energyMeterLine10:10secPoller:reg17:number" }
Number l10MeterModbusID  "ModBus Id [%d]"                      <modbus>         (Line10) ["Status"] { channel="modbus:data:energyMeterLine10:10secPoller:reg21H:number" }
Number l10MeterBaudrate  "Baudrate [MAP(modbusbaud.map):%s]"   <modbus>         (Line10) ["Status"] { channel="modbus:data:energyMeterLine10:10secPoller:reg21L:number" }

// meter 11: Kitchen 2nd group
Number EnergyMeter11_Raw   "Kitchen 2nd group counter (raw) [%.2f kWh]" <energy> (gEnergyRaw)   { channel="modbus:data:energyMeterLine11:10secPoller:reg0:number" }
Number EnergyMeter11_Total "Kitchen 2nd group total [%.2f kWh]"         <energy> (gEnergyTotal, Line11) ["Measurement","Energy"] { influxdb="energy_total_kwh" [meter="11", circuit="kitchen_2"] }
