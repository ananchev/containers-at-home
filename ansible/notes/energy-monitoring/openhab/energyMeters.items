Number l11PowerFactor    "Power Factor [%.3f]"                 <power_factor>   (Line11) ["Measurement"] { channel="modbus:data:energyMeterLine11:10secPoller:reg16:number" }
Number l11Frequency      "Frequency [%.2f Hz]"                 <sine>           (Line11) ["Measurement","Frequency"] { channel="modbus:data:energyMeterLine11:10secPoller:reg17:number" }
Number l11MeterModbusID  "ModBus Id [%d]"                      <modbus>         (Line11) ["Status"] { channel="modbus:data:energyMeterLine11:10secPoller:reg21H:number" }
Number l11MeterBaudrate  "Baudrate [MAP(modbusbaud.map):%s]"   <modbus>         (Line11) ["Status"] { channel="modbus:data:energyMeterLine11:10secPoller:reg21L:number" }

