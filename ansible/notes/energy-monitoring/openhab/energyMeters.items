Number EnergyMeter11_Cost  "Kitchen 2nd group cost total [%.2f €]"      <price>  (gEnergyCost, Line11)  ["Measurement"] { influxdb="energy_cost_total_eur" [meter="11", circuit="kitchen_2"] }
Number l11Voltage        "Voltage [%.1f V]"                    <voltage>        (Line11) ["Measurement","Voltage"] { channel="modbus:data:energyMeterLine11:10secPoller:reg12:number" }
Number l11Current        "Current [%.2f A]"                    <current>        (Line11) ["Measurement","Current"] { channel="modbus:data:energyMeterLine11:10secPoller:reg13:number" }
Number l11ReactivePower  "Reactive Power [%.3f kVar]"          <reactive_power> (Line11) ["Measurement","Power"] { channel="modbus:data:energyMeterLine11:10secPoller:reg15:number" }
Number l11PowerFactor    "Power Factor [%.3f]"                 <power_factor>   (Line11) ["Measurement"] { channel="modbus:data:energyMeterLine11:10secPoller:reg16:number" }
Number l11Frequency      "Frequency [%.2f Hz]"                 <sine>           (Line11) ["Measurement","Frequency"] { channel="modbus:data:energyMeterLine11:10secPoller:reg17:number" }
Number l11MeterModbusID  "ModBus Id [%d]"                      <modbus>         (Line11) ["Status"] { channel="modbus:data:energyMeterLine11:10secPoller:reg21H:number" }
Number l11MeterBaudrate  "Baudrate [MAP(modbusbaud.map):%s]"   <modbus>         (Line11) ["Status"] { channel="modbus:data:energyMeterLine11:10secPoller:reg21L:number" }

