// Electricity price, published (retained) by the energy-tariff container
Thing mqtt:topic:energyTariff "Electricity tariff" (mqtt:broker:c60e6d09) //broker defined via UI
{
    Channels:
        Type number   : electricity "Price, all-in incl. VAT" [ stateTopic="energy/tariff/electricity" ]
        Type datetime : updated     "Price fetched at"       [ stateTopic="energy/tariff/updated" ]
}
